# Owner-licensed Fab source and local content (never publish raw assets).
User downloaded assets/
Content/Asteroid_Library/
Content/SciFiCorridor/
# Licensed and derived content, excluded a level at a time rather than as a whole tree, because git
# cannot re-include anything inside a directory that is itself excluded - and one thing in here has to
# be tracked.
Content/SpaceSurvival/Licensed/*
# The remastered squirrel is the owner's OWN art, not a licensed pack. It sits under Licensed/ only
# because that tree was blanket-ignored. It is the hero the game is about, it is the fallback a clone
# with no packs boots with, and until now it existed on exactly one machine and in no backup.
!Content/SpaceSurvival/Licensed/Hero/
Content/NiagaraExamples/
Content/RPGEnvironmentVFX/
Content/Vefects/
Content/NERVES/
# Stellar Phoenix Shuttle (Fab, built for 5.3). It must live at /Game/Stellar_Phoenix because every
# reference inside the pack is by that package path; moving it under Fab/ would break them all.
Content/Stellar_Phoenix/

Content/SpaceNebulaFantasy/

Content/Spacecraft_Pack/

Content/PyroVFX/

Content/Sci_Fi_Weapons_VFX_AIO/
/Content/Robot_scout_R_21/
/Content/Defect/
/Content/StarterBundle/
/Content/SciFITrooper_Man_03/
/Content/Heavy_space_trooper/
/Content/CosmicMaterial/
/Content/Megastructure_Scifi_World/
/Content/EasyInputPrompts/

# Owner-licensed plugin source and content (Ship Core PRO, ported from the 5.6 install).
/Plugins/ShipCore/

# Tripo bridge generated materials and loose shortcuts.
/Content/TripoModels/
*.lnk

# Local UI layout tool: generated manifest, saved layouts and copied glyph art.
/Tools/UILayout/assets.json
/Tools/UILayout/layout.json
/Tools/UILayout/glyphs/

# Fab listings imported from the vault cache (Scripts/ImportVaultGlb.py): licensed, and outside
# /Game/SpaceSurvival so they cook only when something references them.
/Content/Fab/

# Meshes sent from Blender (Content/Python/ss_send.py): experiments, their materials and textures, and
# kitbashes of licensed pack geometry. Outside /Game/SpaceSurvival so they cook only when something
# references them. A finished original mesh is added on purpose with `git add -f`.
/Content/Blender/
# Scripts/TestSendScenes.py duplicates a licensed pack mesh here; a killed run leaves it until the next run.
/Content/_SSSelfTest/

# Owner-licensed alien NPC (Fab: "Alien / Sci-Fi Humanoid - UE5", standard UE5 skeleton). Ships its own
# IK rig, retargeter, control rigs and locomotion clips; the station recolours its material instances
# per NPC rather than duplicating the mesh.
/Content/Nyxar/

# Owner-licensed MoCap Online animation packs (Mobility Starter, Mocap Basics). Both self-contained on
# their own UE4_Mannequin_Skeleton; the station's alien crew clips are retargeted copies under
# /Game/SpaceSurvival/Licensed, so these two roots are source material and never cook directly.
/Content/MCO_Mocap_Basics/
/Content/Mobility/

# Owner-licensed Retro Futuristic Soldier (Fab). Self-contained: ships its own SK_Mannequin skeleton
# and a full MF_Unarmed_* locomotion set, so it needs no retarget. Selectable from the station kiosk.
/Content/RetroFuturisticSoldier/

# Owner-licensed Paragon heroes and the RamsterZ animation library, installed 2026-09-19. Not adopted:
# the Paragon bodies are 1.2-2.4 GB each, stand 1.8-3.1 m against a 176 cm capsule, and carry MOBA
# ability clips rather than plain locomotion, so none is on the hero roster. Ignored so that a
# `git add .` cannot pull twelve gigabytes of licensed content into the repository.
/Content/ParagonGRIMexe/
/Content/ParagonHowitzer/
/Content/ParagonKwang/
/Content/ParagonPhase/
/Content/ParagonSevarog/
/Content/ParagonYin/
/Content/RamsterZ_FreeAnims_Volume1/

