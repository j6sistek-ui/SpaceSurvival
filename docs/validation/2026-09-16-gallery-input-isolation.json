  "supersedes_diagnosis": "docs/validation/2026-09-16-gallery-package-diagnosis.json",
  "root_cause": {
    "summary": "ASSPlayerController::PlayerTick handled alien-gallery return/switch/reset keys before the bAutomatedSoakInput guard, so physical device input cancelled scripted packaged fixtures.",
    "mechanism": "An XInput controller is registered and polled inside the packaged fixture process (LogInputDeviceRegistry RegisterDevice XInputInterface) even though the run is -RenderOffscreen -unattended and never foreground. A stray Gamepad_FaceButton_Right press called USSAlienGallery::Leave(); Gamepad_FaceButton_Top would call SwitchScene().",
    "first_bad_transition": "ALIEN_GALLERY_INPUT_RETURN automated=1 immediately followed by ALIEN_GALLERY_LEAVE state=2 (Viewing) while the fixture was holding the requested scene, before its stage capture.",
    "rejected_hypotheses": [
      "Level load failure on the asset-layout map: no ALIEN_GALLERY_LOAD_FAILED in any reproduction, and the asset map had already reached Viewing (state=2, assets=1) in every stage-5 failure.",
      "Lost camera or controller during the scene switch: no ALIEN_GALLERY_VIEW_FAILED in any run, and every failing ALIEN_GALLERY_LEAVE recorded controller=1 camera=1.",
      "Missing packaged map: both vendor maps are present in the actual IoStore index."
    ]
  },
  "fix": {
    "file": "Source/SpaceSurvival/Private/SSGameMode.cpp",
    "change": "The gallery branch of ASSPlayerController::PlayerTick returns early when ASSGameMode::bAutomatedSoakInput is set, logging ALIEN_GALLERY_INPUT_SUPPRESSED key=<name>.",
    "player_behaviour_unchanged": "bAutomatedSoakInput is set only by ASSWave10Soak, which is compiled out of Shipping builds. Escape/B still leaves the gallery in normal play.",
    "sha256": "d6b29bef12acef481ac35fe15cddfebcae5160052abf27bc685119feb2e18266"
  },
